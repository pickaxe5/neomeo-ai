# OpenAI API 키 — 팀 요약 카드·개인 브리핑 생성에 사용
OPENAI_API_KEY=your_openai_api_key

# GitHub 토큰 — 0층 데이터 수집(PR·이슈·리뷰 코멘트 읽기)에 사용
GITHUB_TOKEN=your_github_token

# BE Postgres 연결 — run_closure_fill.py가 summary_cards.content를 직접 채워 넣는 데 사용.
# BE backend/.env.example과 같은 DB를 가리켜야 함. 로컬 docker compose 기준 host는
# 컨테이너 밖에서 실행하면 db 대신 localhost.
DATABASE_URL=postgresql+psycopg://neomeo:neomeo@localhost:5432/neomeo
